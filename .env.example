# Generate each key separately with: openssl rand -base64 32
PERMISSIONS_CHECK_API_KEY=replace-with-independent-base64-encoded-32-byte-key
PERMISSIONS_ADMIN_API_KEY=replace-with-a-different-base64-encoded-32-byte-key

# Use a local-only database password. A hexadecimal value avoids connection-string delimiters.
POSTGRES_DB=permissions
POSTGRES_USER=permissions
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32-output
